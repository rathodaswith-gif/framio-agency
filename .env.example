# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Add the same five values in Vercel:
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Project Settings → API Keys → service_role (secret, server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random string of 32+ characters. Make one with: openssl rand -hex 32
# Used to hash visitor IPs for the form's rate limit.
SUBMISSION_HASH_SECRET=

# Any random string. Vercel uses it to call /api/keep-alive once a day.
# Make one with: openssl rand -hex 32
CRON_SECRET=
